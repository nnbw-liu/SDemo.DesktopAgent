{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdemo.local/contracts/schemas/widget.schema.json",
  "title": "DesktopAssembly widget.json",
  "description": "组件清单：渲染属性、布局意图与生命周期；不含业务语义。宿主按 hostApiVersion 做兼容降级，未知字段一律忽略。",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "appId",
    "name",
    "description",
    "version",
    "hostApiVersion",
    "renderer",
    "size",
    "layer",
    "position",
    "behavior",
    "focus",
    "theme"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "当前 1；更高版本宿主跳过并提示升级"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "反向域名；v1 约定为 <appId>.widget"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "hostApiVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "renderer": {
      "type": "string",
      "enum": ["native", "wasm"]
    },
    "native": {
      "$ref": "#/$defs/native"
    },
    "wasm": {
      "type": ["object", "null"],
      "required": ["webRoot", "entry"],
      "properties": {
        "webRoot": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "maxWidth": { "type": "integer", "minimum": 1 },
        "maxHeight": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "string",
      "enum": ["floating", "desktop"]
    },
    "position": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["anchored", "remember"]
        },
        "corner": {
          "type": "string",
          "enum": ["top-left", "top-right", "bottom-left", "bottom-right"]
        },
        "offsetX": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "offsetY": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "snapPx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "rememberPerMonitor": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "behavior": {
      "type": "object",
      "properties": {
        "alwaysOnTopDefault": { "type": "boolean" },
        "dragMode": { "type": "string", "minLength": 1 },
        "clickThrough": {
          "type": "string",
          "enum": ["toggleWithHotkey", "never", "always"]
        },
        "hideBehindFullscreenApp": { "type": "boolean" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "keepAlive": {
          "type": "string",
          "enum": ["onDemand", "always"]
        }
      },
      "additionalProperties": true
    },
    "focus": {
      "type": "object",
      "properties": {
        "stealOnShow": { "type": "boolean" },
        "activateOnClick": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "light", "dark"]
        },
        "followAccent": { "type": "boolean" },
        "surface": {
          "type": "string",
          "enum": ["acrylic", "opaque"]
        }
      },
      "additionalProperties": true
    },
    "activation": {
      "type": ["object", "null"],
      "properties": {
        "hotkey": { "type": ["string", "null"] },
        "launchOnStartup": { "type": "boolean" },
        "showInTray": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "enum": ["http-localhost", "notifications"]
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/configField" }
        }
      },
      "additionalProperties": true,
      "description": "设置表单的 JSON Schema 子集；宿主只渲染 boolean / integer / number / string(enum) / string+format=path"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "renderer": { "const": "native" } },
        "required": ["renderer"]
      },
      "then": { "required": ["native"] }
    },
    {
      "if": {
        "properties": { "renderer": { "const": "wasm" } },
        "required": ["renderer"]
      },
      "then": { "required": ["wasm"] }
    },
    {
      "if": {
        "properties": {
          "layer": { "const": "desktop" },
          "renderer": { "const": "native" }
        },
        "required": ["layer", "renderer"]
      },
      "then": {
        "description": "契约冲突：native 不允许贴桌面层（跨进程 SetParent 不可靠）",
        "not": {}
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "native": {
      "type": "object",
      "required": ["process"],
      "properties": {
        "process": { "type": "string", "minLength": 1 },
        "layered": { "type": "boolean" },
        "resizable": { "type": "boolean" },
        "minSize": { "$ref": "#/$defs/minSize" }
      },
      "additionalProperties": true
    },
    "minSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "opacity": {
      "type": "object",
      "properties": {
        "default": { "type": "number", "minimum": 0, "maximum": 1 },
        "min": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "configField": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["boolean", "integer", "number", "string"]
        },
        "title": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": { "type": "array" },
        "format": {
          "type": "string",
          "enum": ["path"]
        }
      },
      "additionalProperties": true
    }
  }
}


